{
  "expo": {
    "name": "PortifolioGame",
    "slug": "appexpo",
    "owner": "davimendes",
    "version": "1.0.0",
    "description": "Portfólio mobile desenvolvido em React Native com Expo, Expo Router e jogo interativo integrado ao aplicativo.",
    "githubUrl": "https://github.com/DaviMMendes/AppExpo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "appexpo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davimendes.appexpo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.davimendes.appexpo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}